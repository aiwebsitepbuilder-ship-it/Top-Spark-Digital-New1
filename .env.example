# TOP SPARK DIGITAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for production or local deployment (Do not commit secrets to git)

# SERVER
PORT=3000
NODE_ENV="production"
APP_URL="https://topsparkdigital.com"

# SECURITY & AUTHENTICATION
SESSION_SECRET="replace-with-a-random-64-char-hex-secret"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# SMTP NOTIFICATIONS (info@topsparkdigital.com)
# Obtain these from Hostinger Email, Google Workspace, or your SMTP provider
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="info@topsparkdigital.com"
SMTP_PASS="your-secure-smtp-password"
NOTIFICATION_EMAIL="info@topsparkdigital.com"

# GEMINI_API_KEY: Optional if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

